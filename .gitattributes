# Normaliza line endings: armazena LF no repositorio, converte para CRLF no checkout Windows.
* text=auto eol=lf

# Arquivos binarios (nao converter)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.duckdb binary
*.parquet binary
*.pyc binary

# Scripts Windows mantem CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell scripts mantem LF
*.sh text eol=lf
